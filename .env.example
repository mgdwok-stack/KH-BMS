# Database Configuration
DATABASE_URL=postgresql://bidbot:bidbot_password@localhost:5432/bidbot_db

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# API Keys
# 공공데이터포털에서 발급받은 API 키를 입력하세요
PROCUREMENT_API_KEY=your_api_key_here

# API URLs
PROCUREMENT_API_BASE_URL=http://apis.data.go.kr/1230000/ScsbidInfoService

# Application Settings
APP_NAME=Bid-Bot Clone
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ML Model Settings
MODEL_PATH=./models
DNBP_MODEL_PATH=./models/dnbp_model.h5
LSTM_MODEL_PATH=./models/lstm_model.h5
ENSEMBLE_WEIGHTS=0.6,0.4  # DNBP, LSTM

# Data Collection Settings
DATA_COLLECTION_INTERVAL=3600  # seconds (1 hour)
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
